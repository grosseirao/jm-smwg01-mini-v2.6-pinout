+		(unsigned int)mac[3], (unsigned int)mac[4], (unsigned int)mac[5]);
+}
+
+static void DRV_MDNS_UpdateZigbeeService(const u8_t mac[6]) {
+	if (!DRV_IsRunning("uarttcp")) {
+		if (mdnsZigbeeService) {
+			mDNSDeregisterService(mdnsZigbeeService);
+			mdnsZigbeeService = NULL;
+		}
+		return;
+	}
+	if (mdnsZigbeeService || mdnsRetryTicks) {
+		return;
+	}
+
+	char serialNumber[13];
+	snprintf(serialNumber, sizeof(serialNumber), "%02x%02x%02x%02x%02x%02x",
+		(unsigned int)mac[0], (unsigned int)mac[1], (unsigned int)mac[2],
+		(unsigned int)mac[3], (unsigned int)mac[4], (unsigned int)mac[5]);
+
+	TXTRecordRef txt;
+	TXTRecordCreate(&txt, 0, NULL);
+	if (TXTRecordSetValue(&txt, "radio_type", 4, "ezsp") == 0 &&
+		TXTRecordSetValue(&txt, "serial_number", sizeof(serialNumber) - 1, serialNumber) == 0) {
+		mdnsZigbeeService = mDNSRegisterService(mdnsHost, "_zigbee-coordinator._tcp", "local", 8888, &txt);
+	}
+	TXTRecordDeallocate(&txt);
+	if (!mdnsZigbeeService) {
+		mdnsRetryTicks = 5;
+		addLogAdv(LOG_ERROR, LOG_FEATURE_HTTP, "DRV_MDNS: Zigbee service registration failed");
+	}
+}
+
+/* Home Assistant's ESPHome integration discovers devices through this
+ * service type. It needs the Wi-Fi MAC in "mac"; the instance name must
+ * match the name the API reports in HelloResponse and DeviceInfo. */
+static void DRV_MDNS_UpdateESPHomeService(const u8_t mac[6]) {
+	if (!DRV_IsRunning("ESPHomeAPI")) {
+		if (mdnsESPHomeService) {
+			mDNSDeregisterService(mdnsESPHomeService);
+			mdnsESPHomeService = NULL;
+		}
+		return;
+	}
+	if (mdnsESPHomeService || mdnsRetryTicks) {
+		return;
+	}
+
+	char macText[13];
+	const char *friendlyName = CFG_GetDeviceName();
+	snprintf(macText, sizeof(macText), "%02x%02x%02x%02x%02x%02x",
+		(unsigned int)mac[0], (unsigned int)mac[1], (unsigned int)mac[2],
+		(unsigned int)mac[3], (unsigned int)mac[4], (unsigned int)mac[5]);
+
+	TXTRecordRef txt;
+	TXTRecordCreate(&txt, 0, NULL);
+	if (TXTRecordSetValue(&txt, "mac", sizeof(macText) - 1, macText) == 0 &&
+		TXTRecordSetValue(&txt, "network", 4, "wifi") == 0 &&
+		TXTRecordSetValue(&txt, "platform", strlen(PLATFORM_MCU_NAME), PLATFORM_MCU_NAME) == 0 &&
+		TXTRecordSetValue(&txt, "friendly_name", strlen(friendlyName), friendlyName) == 0) {
+		mdnsESPHomeService = mDNSRegisterService(mdnsHost, "_esphomelib._tcp", "local", 6053, &txt);
+	}
+	TXTRecordDeallocate(&txt);
+	if (!mdnsESPHomeService) {
+		mdnsRetryTicks = 5;
+		addLogAdv(LOG_ERROR, LOG_FEATURE_HTTP, "DRV_MDNS: ESPHome service registration failed");
+	}
+}
+
+static void DRV_MDNS_UpdateServices(const u8_t mac[6]) {
+	DRV_MDNS_UpdateZigbeeService(mac);
+	DRV_MDNS_UpdateESPHomeService(mac);
+}
+
+static void DRV_MDNS_StopResponder(void) {
+	if (mdnsAddress) {
+		/* The SDK deregisters services as part of deinitialization. */
+		mDNSResponderDeinit();
+		mdnsAddress = 0;
+		mdnsZigbeeService = NULL;
+		mdnsESPHomeService = NULL;
+	}
+	mdnsHost[0] = 0;
+}
+
+void DRV_MDNS_Init(void) {
+	DRV_MDNS_Active = 1;
+	mdnsRetryTicks = 0;
+}
+
+void DRV_MDNS_RunEverySecond(void) {
+	struct netif *sta = &xnetif[0];
+	u32_t address = netif_ip4_addr(sta)->addr;
+	char hostname[sizeof(mdnsHost)];
+	TXTRecordRef txt;
+	DNSServiceRef service;
+
+	if (!Main_IsConnectedToWiFi() || Main_IsOpenAccessPointMode() ||
+		!netif_is_up(sta) || !address || sta->hwaddr_len != 6) {
+		DRV_MDNS_StopResponder();
+		mdnsRetryTicks = 0;
+		return;
+	}
+
+	DRV_MDNS_MakeHostname(hostname, sta->hwaddr);
+	if (mdnsRetryTicks) {
+		--mdnsRetryTicks;
+	}
+	if (mdnsAddress == address && !strcmp(mdnsHost, hostname)) {
+		DRV_MDNS_UpdateServices(sta->hwaddr);
+		return;
+	}
+	if (mdnsRetryTicks && !mdnsAddress) {
+		return;
+	}
+	mdnsRetryTicks = 0;
+
+	DRV_MDNS_StopResponder();
+	strcpy(mdnsHost, hostname);
+	if (mDNSResponderInit() != 0) {
+		mdnsHost[0] = 0;
+		mdnsRetryTicks = 5;
+		addLogAdv(LOG_ERROR, LOG_FEATURE_HTTP, "DRV_MDNS: Realtek responder initialization failed");
+		return;
+	}
+
+	TXTRecordCreate(&txt, 0, NULL);
+	service = mDNSRegisterService(mdnsHost, "_http._tcp", "local", 80, &txt);
+	TXTRecordDeallocate(&txt);
+	mdnsAddress = address;
+	if (!service) {
+		addLogAdv(LOG_ERROR, LOG_FEATURE_HTTP, "DRV_MDNS: HTTP service registration failed");
+	}
+	DRV_MDNS_UpdateServices(sta->hwaddr);
+	addLogAdv(LOG_INFO, LOG_FEATURE_HTTP, "DRV_MDNS: Realtek responder started (%s.local)", mdnsHost);
+}
+
+void DRV_MDNS_RunQuickTick(void) {
+}
+
+void DRV_MDNS_Shutdown(void) {
+	DRV_MDNS_StopResponder();
+	DRV_MDNS_Active = 0;
+}
