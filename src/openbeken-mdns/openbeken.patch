+// Any thread: queue a frame that must not be lost, waiting up to wait_ms for
+// room. Used for serial proxy data, which the ASH tap may already have
+// acknowledged to the NCP.
+bool ESPHome_API_SendFrameWait(uint32_t msg_type, const uint8_t* payload, uint32_t payload_len, uint32_t wait_ms)
+{
+	if(client_sock == INVALID_SOCK || s_tx_queue == NULL) return false;
+	tx_frame_t* f = ESPHome_API_BuildFrame(msg_type, payload, payload_len, false);
+	if(!f)
+	{
+		s_tx_dropped++;
+		return false;
+	}
+	if(xQueueSend(s_tx_queue, &f, pdMS_TO_TICKS(wait_ms)) != pdTRUE)
+	{
+		os_free(f);
+		ADDLOG_ERROR(LOG_FEATURE_DRV, "ESPHomeAPI: TX queue full, dropped frame type %d", msg_type);
+		s_tx_dropped++;
+		return false;
+	}
+	return true;
+}
